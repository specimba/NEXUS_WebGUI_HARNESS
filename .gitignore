# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# local-* was silently eating src/components/praison/settings/local-models.tsx
# (three lost-file incidents: r14→r15→r16→r19/20). Keep the glob for runtime
# artifacts (root-anchored), but NEVER ignore app source under src/.
/local-*
/local-*/*
!src/**
!src/components/praison/settings/local-models.tsx
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# sandbox runtime artifacts
tool-results/
download/
*.out
.db

# sqlite
db/*.db
db/*.db-journal

# user uploads (local reference material only)
/upload

# local backup artifacts (bundles + db snapshots)
backups/

# local runtime logs (never ship)
dev.log*
ops/heartbeat.log

# r179: provider vault contains LIVE keys — local-only, never pushed (GitHub push protection + directive §credentials)
user-artifacts/**/praison-provider-vault*.json
user-artifacts/**
ops/chrome-profile/
# r449: QA browser profile (Chrome leveldb binaries, hundreds of files) —
# same class as ops/chrome-profile/ above, created later by the QA harness.
.chrome-qa-profile/
# r449: rollback-incident quarantine tarballs — incident artifacts, not source.
lost-era-quarantine-*.tar.gz

# r493: vault rehydration seed holds plaintext keys — same trust class as db/*.db, NEVER commit
db/vault-seed.json
# r526: vault at-rest master key (AES-256-GCM) — machine-held, same trust class, NEVER commit
db/vault-master.key

# HF hub token (r501) — owner PAT, server-side only
/db/hf-token.txt

# agent round context (local working records, not source)
agent-ctx/

# r522 liveness supervisor runtime artifacts
dev-supervisor.log
scripts/.liveness-supervisor.pid

# r609: WAL sidecars are volatile runtime state (WAL mode since r608) - the .db itself stays tracked
db/custom.db-shm
db/custom.db-wal
