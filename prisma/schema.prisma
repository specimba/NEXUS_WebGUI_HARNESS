// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── r28: Free/New Model Tracker ─────────────────────────────────────────────
// Snapshot store for the 4-8h catalog watcher. Dedupe key is
// "providerId::modelId" — the same hopKey the relay uses, so tracker rows can
// be pinned straight into a chat.

model TrackedModel {
  id            String   @id // "providerId::modelId"
  providerId    String
  modelId       String
  displayName   String?
  contextWindow Int?
  priceIn       Float?
  priceOut      Float?
  free          Boolean  @default(false)
  /// How many syncs have seen this row (false-alert defense: 2+ = confirmed).
  sightings     Int      @default(1)
  /// True when firstSeenAt is inside the 48h "firsthand window".
  isNew         Boolean  @default(true)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  removedAt     DateTime?
  meta          String?  // JSON blob (owned_by, hf downloads, upstream created, …)

  @@index([isNew, firstSeenAt])
  @@index([free, firstSeenAt])
  @@index([lastSeenAt])
}

model TrackerEvent {
  id         String   @id @default(cuid())
  type       String // "new" | "removed" | "reappeared"
  modelKey   String // "providerId::modelId"
  providerId String
  modelId    String
  payload    String? // JSON summary snapshot of the row at event time
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model TrackerMeta {
  id         String    @id // source id ("openrouter", "vyce", …)
  lastSyncAt DateTime?
  lastOk     Boolean   @default(false)
  lastError  String?
  modelCount Int       @default(0)
  payload    String?   // last sync summary JSON
}

// ─── r49: Relay failover event log (the routing state machine's memory) ──────
// Every hop attempt the rotator makes — ok, capacity-cooled, hard-demoted —
// lands here, keyed by the request id that threaded through all attempts.
// No secrets: hop keys and clipped error prose only, never API keys.

model RelayEvent {
  id         String   @id @default(cuid())
  requestId  String // correlation id — one request maps to every attempt it made
  hopKey     String // "providerId::modelId"
  providerId String
  modelId    String
  ok         Boolean
  /// "rate-limit" | "network" | "timeout" | "credits" | "auth" | "region" | "model" | "unknown"
  kind       String?
  /// "primary" | "relay" | "probe"
  attempt    String   @default("relay")
  /// What the rotator did: "served" | "rotated" | "cooled" | "demoted" | "exhausted" | "probe-revived" | "probe-extended"
  action     String?
  latencyMs  Int?
  error      String? // clipped human prose — no keys, no full bodies
  transport  String?  // "server" | "browser"
  createdAt  DateTime @default(now())

  @@index([requestId])
  @@index([providerId, createdAt])
  @@index([createdAt])
  @@index([hopKey, createdAt])
}