// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── r28: Free/New Model Tracker ─────────────────────────────────────────────
// Snapshot store for the 4-8h catalog watcher. Dedupe key is
// "providerId::modelId" — the same hopKey the relay uses, so tracker rows can
// be pinned straight into a chat.

model TrackedModel {
  id            String   @id // "providerId::modelId"
  providerId    String
  modelId       String
  displayName   String?
  contextWindow Int?
  priceIn       Float?
  priceOut      Float?
  free          Boolean  @default(false)
  /// How many syncs have seen this row (false-alert defense: 2+ = confirmed).
  sightings     Int      @default(1)
  /// True when firstSeenAt is inside the 48h "firsthand window".
  isNew         Boolean  @default(true)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  removedAt     DateTime?
  meta          String?  // JSON blob (owned_by, hf downloads, upstream created, …)

  @@index([isNew, firstSeenAt])
  @@index([free, firstSeenAt])
  @@index([lastSeenAt])
}

model TrackerEvent {
  id         String   @id @default(cuid())
  type       String // "new" | "removed" | "reappeared"
  modelKey   String // "providerId::modelId"
  providerId String
  modelId    String
  payload    String? // JSON summary snapshot of the row at event time
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model TrackerMeta {
  id         String    @id // source id ("openrouter", "vyce", …)
  lastSyncAt DateTime?
  lastOk     Boolean   @default(false)
  lastError  String?
  modelCount Int       @default(0)
  payload    String?   // last sync summary JSON
}
// ─── v20: Headless autopilot (server-side scheduled workflow runs) ──────────
// The browser pushes workflow snapshots here; when the tab is CLOSED (client
// heartbeat stale >2min), the local scheduler mini-service fires due runs
// using the platform's built-in engine. Local-only: everything stays on this
// machine — BYOK keys are NOT needed server-side and never leave the browser.
model AutomationWorkflow {
  id          String    @id
  name        String
  task        String
  stepsJson   String
  intervalMs  Int
  enabled     Boolean   @default(true)
  nextRunAt   DateTime  @default(now())
  lastRunAt   DateTime?
  failStreak  Int       @default(0)
  registeredAt DateTime @default(now())
  updatedAt   DateTime  @updatedAt
  runs        AutomationRun[]
}

model AutomationRun {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowName String
  trigger      String   @default("schedule") // schedule | manual
  status       String   @default("running")  // running | done | error
  currentStep  Int      @default(0)
  stepsTotal   Int      @default(0)
  stepsJson    String   @default("[]")       // [{label, output, ms, ok}]
  finalReport  String?
  error        String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([status, startedAt])
  @@index([workflowId, startedAt])
}

// Single-row liveness: the open tab heartbeats every 60s; the server tick
// stands down while fresh (client drives with user keys), fires when stale.
model AutomationState {
  id         String   @id @default("singleton")
  lastSeenAt DateTime @default(now())
}

// ─── v25: Local Automation Vault ─────────────────────────────────────────────
// Opt-in, LOCAL-ONLY key slots for the headless server lane. While the tab is
// open the BYOK lane drives with keys that never leave the browser; when the
// user chooses, a key stored here lets closed-tab runs dial with their own
// provider key instead of the shared built-in gateway. GET never returns the
// raw key — only a masked preview. Nothing ever leaves this machine.
model AutomationVault {
  id        String   @id @default(cuid())
  provider  String   @unique // "builtin" = the built-in engine's gateway key slot
  key       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── r455: Durable run-report archive (local lane) ───────────────────────────
// User report "Local storage is full" exposed the flip side of local-first:
// localStorage holds only a TRIMMED live state (r414), so full research
// reports lived in RAM and whatever the trim kept. The server lane already
// lands full runs in AutomationRun; this table is that durable tier for
// LOCAL-lane runs — every settled run archives its full steps + tool calls
// here automatically. Agents read/maintain it via /api/runs/archive
// (GET list/detail, DELETE prune); id = the WorkflowRun id (upsert, so a
// resumed run re-archives over its earlier partial snapshot).
model RunReport {
  id           String    @id
  workflowId   String
  workflowName String
  task         String
  source       String    @default("manual") // manual | scheduled
  status       String // done | error | stopped | partial | blocked
  depth        String?
  stepsJson    String    @default("[]") // full [{stepId,agentName,label,output,toolCalls,status,ms}]
  error        String?
  toolCalls    Int       @default(0)
  durationMs   Int?
  startedAt    DateTime
  finishedAt   DateTime?
  archivedAt   DateTime  @updatedAt

  @@index([workflowId, startedAt])
  @@index([archivedAt])
}

// ─── r497: Capability Radar — the hourly platform self-check ─────────────────
// Owner directive: "cron automation for every 1-hour check … with that new
// workflow, findings, experimental, and tryable discoveries, we can adapt
// here for improvements in our agent and platform capabilities." The radar
// is a DETERMINISTIC (LLM-free, vault-free — it must work while the vault is
// empty and the tab is closed) hourly scan of the intelligence tables the
// platform already keeps: the durable run archive, the registry, the vault,
// the tracker catalog and the gateway pulse. One row per UTC hour bucket
// (id = the bucket) → re-running within the same hour is an idempotent
// upsert, never a duplicate. Findings carry a `tryable` — a concrete
// adaptation the owner (or an agent) can act on immediately.
model CapabilityCheck {
  id         String   @id // hour bucket "2026-10-18T17:00Z" (idempotent upsert)
  digestJson String   @default("{}")
  findings   Int      @default(0)
  critical   Int      @default(0)
  warnings   Int      @default(0)
  tryables   Int      @default(0)
  durationMs Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

// ─── r514: Platform settings KV (server-only) ────────────────────────────────
// Minimal key→string store for server-side platform state that must survive
// reloads but never belongs in the browser: the Webshare egress token and the
// per-upstream egress routing map (`egress.routing`). Values are read only by
// server routes — the token NEVER re-enters any API response (masked last-4
// previews only); proxy credentials built from it live in process memory for
// ≤60s and are never persisted, logged or serialized.
model PlatformSetting {
  id        String   @id // "egress.webshare.token" | "egress.routing"
  value     String
  updatedAt DateTime @updatedAt
}

// ─── r515: Autonomous Improvement Engine (AIE) ───────────────────────────────
// The owner's r515 directive: the external 15-min cron patrol keeps getting
// purged (7×) — the platform itself must carry autonomy. The AIE is a
// deterministic, vault-free 10-minute server loop: it reads first-party
// signals (research backlog, radar digest, run-archive failure rate, vault
// slots), proposes 1-5 ranked NEXT MOVES, executes only SAFE vault-free ones
// (GitHub research = unauthenticated public API; no LLM dials, no workflow
// mutations), and logs every cycle idempotently per 10-minute bucket.
model ResearchQueue {
  id           String    @id // normalized: "gh:owner/repo" or "url:<sha1-12>"
  kind         String // "repo" | "url"
  owner        String? // for repos
  repo         String?
  url          String?
  source       String // "owner-sweep-2410" | "radar-seed" | "next-move" | manual
  status       String // "queued" | "researched" | "skipped" | "failed"
  score        Int? // 0-10 relevance
  verdict      String? // ADAPT | WATCH | SKIP
  notes        String? // distilled findings (≤2000 chars)
  researchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

model NextMove {
  id          String    @id // "mv_<ulid-ish>"
  cycleId     String // which AIE cycle generated it
  rank        Int
  kind        String // "research-repo" | "import-seed" | "run-workflow" | "radar-followup" | "await-owner"
  title       String
  rationale   String
  payloadJson String // action-specific params
  status      String // "proposed" | "executed" | "executing" | "failed" | "skipped"
  executedAt  DateTime?
  result      String? // ≤2000 chars honest outcome
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

model AutonomyLog {
  id        String   @id // "cyc_<bucket>" or "rep_<bucket>"
  kind      String // "cycle" | "report"
  summary   String // ≤500 chars
  movesJson String // JSON array [{id,title,kind,status}] of that cycle
  statsJson String // {queued, researched, failed, ms, laneUsed}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, createdAt])
}

// ─── r515-c: Strategic Context Layer (SCL) — the connective tissue ───────────
// Owner diagnosis: the AIE ran but "proposed no-ops" because nothing CONNECTED
// the research signals to a living strategy ("we need proper instruction and
// agent.md tasks.md worklogs.md etc — a strategical system for disciplined
// continuous work … this is still void"). StrategyItem is the RUNTIME half of
// that system: a queryable integration backlog that the AIE advances (data-only
// moves), the briefing endpoint assembles into agent-ready context packs, and
// the chat-side architect distills/implements in dev rounds. The GIT half is
// docs/strategy/{AGENT,TASKS,WORKLOGS}.md — AGENT.md carries the capability
// elevation cycle doctrine: in-app workers research (they can never pause or
// edit the platform that serves them), the chat-side architect distills and
// implements, the Owner decides and schedules. Recursive by construction.
model StrategyItem {
  id            String    @id // "TASK-<n>" (TASK-100 upward, sequential)
  title         String
  kind          String // "integration" | "research" | "experiment" | "owner-action"
  source        String // "repo-sweep-2410" | "radar" | "aie:auto-adapt" | "owner" | "chat-side"
  status        String // "proposed" | "ready" | "in-progress" | "blocked" | "done"
  priority      Int       @default(2) // 1 high · 2 normal · 3 low
  nextAction    String    @default("")
  acceptance    String? // done-when criteria
  notes         String?
  dedupeKey     String?   @unique // sync idempotency ("seed:slug", "auto-adapt:gh:owner/repo", …)
  originJson    String? // machine-origin payload (score, queue id, finding)
  advancedCount Int       @default(0) // how many AIE cycles advanced it
  advancedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, priority])
}
